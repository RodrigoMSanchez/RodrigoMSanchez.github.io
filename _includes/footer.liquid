{%- assign cur_lang = page.lang | default: site.lang -%}
{%- assign t = site.data.i18n[cur_lang] -%}
{% capture footer_contents %}
  &copy; {{ t.copyright }} {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ t.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    {%- assign month_index = 'now' | date: '%-m' | plus: 0 | minus: 1 -%}
    {%- assign month_name = t.months[month_index] -%}
    {%- assign day = 'now' | date: '%-d' -%}
    {%- assign year = 'now' | date: '%Y' -%}
    {{- t.last_updated }}: {{ t.date_long | replace: '%m', month_name | replace: '%d', day | replace: '%y', year }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
