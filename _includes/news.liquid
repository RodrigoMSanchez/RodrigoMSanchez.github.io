{%- assign cur_lang = page.lang | default: site.lang -%}
{%- assign t = site.data.i18n[cur_lang] -%}
{%- assign lang_news = site.news | where: "lang", cur_lang -%}
<div class="news">
  {% if lang_news != blank %}
    {% assign news_size = lang_news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = lang_news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            {%- assign month_index = item.date | date: '%-m' | plus: 0 | minus: 1 -%}
            <th scope="row" style="width: 20%">{{ t.months[month_index] | capitalize }} {{ item.date | date: '%Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>{{ t.news_empty }}</p>
  {% endif %}
</div>
